NODE_ENV=development
PORT=4000

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hr_management?schema=public
REDIS_URL=redis://localhost:6379/0

# Required in production: random, >= 32 characters, different from each other.
# Generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=1209600

PASSWORD_RESET_TTL=3600
EMAIL_VERIFICATION_TTL=86400

STORAGE_DIR=storage
MAX_UPLOAD_BYTES=15728640

RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX=300

# Comma-separated list of allowed browser origins, or *. Unset: * in
# development, no cross-origin access in production.
CORS_ORIGIN=http://localhost:3000

# Number of reverse proxies in front of the API (e.g. 1 behind a load
# balancer), or their addresses. Unset: X-Forwarded-For is ignored.
# TRUST_PROXY=1

SMTP_FROM=no-reply@hrvantage.example
APP_PUBLIC_URL=http://localhost:4000
